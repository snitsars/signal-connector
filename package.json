{
  "name": "signal-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge a Signal chat to a local opencode coding agent.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "signal-connector": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "link": "tsx src/cli/link.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "smol-toml": "^1.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
