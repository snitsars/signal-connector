{
  "name": "signal-connector",
  "version": "0.1.0",
  "private": false,
  "description": "Bridge a Signal chat to a local opencode coding agent.",
  "license": "MIT",
  "author": "snitsars",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snitsars/signal-connector.git"
  },
  "bugs": {
    "url": "https://github.com/snitsars/signal-connector/issues"
  },
  "keywords": [
    "signal",
    "signal-cli",
    "opencode",
    "coding-agent",
    "bridge",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "plugins"
  ],
  "bin": {
    "signal-connector": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "link": "tsx src/cli/link.ts",
    "dry": "tsx src/cli/dryRun.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.9.1",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "smol-toml": "^1.3.1",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
